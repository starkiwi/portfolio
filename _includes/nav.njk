<nav aria-label="Main navigation">
        <div id="slicknav_menu"></div>
        <ul id="menu">
        {% for item in nav %}
            <li>

            {% if item.children %}
            <a href="#" class="submenu-parent">
            {{ item.label }}
            </a>

            <ul>
            {% for child in item.children %}
            <li>
            <a href="{{ child.url }}"
            {% if page.url == child.url %}
            aria-current="page"
            {% endif %}>
            {{ child.label }}
            </a>
            </li>
            {% endfor %}
            </ul>

            {% else %}
            <a href="{{ item.url }}"
            {% if page.url == item.url %}
            aria-current="page"
            {% endif %}>
            {{ item.label }}
            </a>
            {% endif %}
            </li>
            {% endfor %}
        </ul>
</nav>