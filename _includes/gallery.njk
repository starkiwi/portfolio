{% extends "base.njk" %}

{% block content %}
<div id="input_content">
    {{ content | safe }}
</div>
<h1>Projects</h1>
<section class="gallery">
    {% for item in collections.project | sort(true, false, "data.numericalDate") %}
        <div class="card">
            <a href="{{ item.data.permalink }}">
            <img class="gif_img" src="{{ item.data.square }}">
            <div class = "caption">
                <h4>{{ item.data.title }}</h4>
                <p>{{ item.data.description }}</p>
            </div>
            </a>
        </div>
    {% endfor %}
</section>
{% endblock %}